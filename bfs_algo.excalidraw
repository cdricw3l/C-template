      "created": 1792132772793,
      "link": null,
      "locked": false,
      "text": "Node idx = i\nNode left child = 2 * i + 1\nNode right child = 2 * i + 2\nParent node = i / 2",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Node idx = i\nNode left child = 2 * i + 1\nNode right child = 2 * i + 2\nParent node = i / 2",
      "autoResize": true,
      "lineHeight": 1.25,
